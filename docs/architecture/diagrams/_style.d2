vars: {d2-config: {layout-engine: tala; theme-id: 0; pad: 40}}
classes: {
  py: {style: {fill: "#e8f0fe"; stroke: "#1a56db"; font-color: "#0b2a6b"; border-radius: 6}}
  agent: {style: {fill: "#f1e8ff"; stroke: "#7e3af2"; font-color: "#3b0f86"; border-radius: 6}}
  guard: {style: {fill: "#fde8e8"; stroke: "#e02424"; font-color: "#771d1d"; stroke-width: 2; border-radius: 6}}
  node: {style: {fill: "#ecfdf5"; stroke: "#047857"; font-color: "#064e3b"; border-radius: 6}}
  data: {style: {fill: "#fdf6b2"; stroke: "#c27803"; font-color: "#633112"; border-radius: 6}}
  ext: {style: {fill: "#f3f4f6"; stroke: "#6b7280"; font-color: "#1f2937"; border-radius: 6}}
  you: {style: {fill: "#def7ec"; stroke: "#0e9f6e"; font-color: "#014737"; stroke-width: 2; border-radius: 6}}
  q: {shape: diamond; style: {fill: "#ffffff"; stroke: "#1a56db"; font-color: "#0b2a6b"}}
  ok: {style: {fill: "#def7ec"; stroke: "#0e9f6e"; font-color: "#014737"; border-radius: 6}}
  bad: {style: {fill: "#fde8e8"; stroke: "#e02424"; font-color: "#771d1d"; border-radius: 6}}
  red: {style: {stroke: "#e02424"; stroke-width: 2}}
  green: {style: {stroke: "#0e9f6e"; stroke-width: 2}}
}
